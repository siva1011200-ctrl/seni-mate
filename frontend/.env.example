# Copy to .env for local development, or set these in the Vercel dashboard.

# true  = built-in mock backend, no server needed
# false = real backend
VITE_USE_MOCK=false

# Local dev: leave unset (defaults to /api, proxied by Vite to :8000).
# Production (Vercel): set to your Render backend URL, e.g.
# VITE_API_URL=https://senimate-api.onrender.com
# VITE_API_URL=
